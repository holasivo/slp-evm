# Copy to .env and fill in as needed. Every variable is optional: without
# SIVO_WALLET_PRIVATE_KEY no live networks are configured, and compilation
# and the test suite run entirely against the in-process Hardhat network.

# Alchemy API key used to build RPC URLs for all networks (see config/chains.ts)
ALCHEMY_API_KEY=

# Per-network RPC override, replaces the Alchemy URL (e.g. RPC_URL_SEPOLIA)
# RPC_URL_MAINNET=

# Deployer/operator wallet used for `hardhat ignition deploy` and scripts
SIVO_WALLET_PRIVATE_KEY=

# Contract verification (hardhat-verify)
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=

# Gas reporter (REPORT_GAS=true) pricing lookups
COINMARKETCAP_API_KEY=
REPORT_GAS=false

# Safe multisig proposals (ignition/modules/propose.ts, scripts/propose-*)
SAFE_ADDRESS=
SAFE_API_KEY=

# Certora formal verification (certora/)
CERTORAKEY=
